module empu_bench_top (
  HCLK,
  HRST,
  UART0RXD,
  UART0TXD,
  GPIO,
  JTAG_7,
  JTAG_9,
  LOCKUP,
  HALTED
)
;
input HCLK;
input HRST;
input UART0RXD;
output UART0TXD;
inout [15:0] GPIO;
inout JTAG_7;
inout JTAG_9;
output LOCKUP;
output HALTED;
wire HCLK_d;
wire HRST_d;
wire n11_5;
wire pll_clk0;
wire rLockOut;
wire [1:0] rst_sync;
wire VCC;
wire GND;
  IBUF HCLK_ibuf (
    .O(HCLK_d),
    .I(HCLK) 
);
  IBUF HRST_ibuf (
    .O(HRST_d),
    .I(HRST) 
);
  LUT2 n11_s1 (
    .F(n11_5),
    .I0(HRST_d),
    .I1(rLockOut) 
);
defparam n11_s1.INIT=4'hB;
  DFFCE rst_sync_0_s0 (
    .Q(rst_sync[0]),
    .D(VCC),
    .CLK(pll_clk0),
    .CLEAR(n11_5),
    .CE(VCC) 
);
  DFFCE rst_sync_1_s0 (
    .Q(rst_sync[1]),
    .D(rst_sync[0]),
    .CLK(pll_clk0),
    .CLEAR(n11_5),
    .CE(VCC) 
);
  Gowin_PLL u_pll (
    .HCLK_d(HCLK_d),
    .pll_clk0(pll_clk0),
    .rLockOut(rLockOut)
);
  Gowin_EMPU_M1_Top u_empu (
    .UART0RXD(UART0RXD),
    .pll_clk0(pll_clk0),
    .JTAG_9(JTAG_9),
    .rst_sync(rst_sync[1]),
    .LOCKUP(LOCKUP),
    .HALTED(HALTED),
    .UART0TXD(UART0TXD),
    .JTAG_7(JTAG_7),
    .GPIO(GPIO[15:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* empu_bench_top */
