module top (
  HCLK,
  HRST,
  SWCLK,
  SWDIO,
  LED,
  GPIO
)
;
input HCLK;
input HRST;
input SWCLK;
inout SWDIO;
output [3:0] LED;
output [1:0] GPIO;
wire HCLK_d;
wire HRST_d;
wire SWCLK_d;
wire SWDIO_in;
wire clk_sys;
wire n6_6;
wire swdio_6;
wire swdio_o_Z;
wire [3:0] LED_d;
wire [1:0] GPIO_d;
wire VCC;
wire GND;
  IBUF HCLK_ibuf (
    .O(HCLK_d),
    .I(HCLK) 
);
  IBUF HRST_ibuf (
    .O(HRST_d),
    .I(HRST) 
);
  IBUF SWCLK_ibuf (
    .O(SWCLK_d),
    .I(SWCLK) 
);
  IOBUF SWDIO_iobuf (
    .O(SWDIO_in),
    .IO(SWDIO),
    .I(swdio_o_Z),
    .OEN(swdio_6) 
);
  OBUF LED_0_obuf (
    .O(LED[0]),
    .I(LED_d[0]) 
);
  OBUF LED_1_obuf (
    .O(LED[1]),
    .I(LED_d[1]) 
);
  OBUF LED_2_obuf (
    .O(LED[2]),
    .I(LED_d[2]) 
);
  OBUF LED_3_obuf (
    .O(LED[3]),
    .I(LED_d[3]) 
);
  OBUF GPIO_0_obuf (
    .O(GPIO[0]),
    .I(GPIO_d[0]) 
);
  OBUF GPIO_1_obuf (
    .O(GPIO[1]),
    .I(GPIO_d[1]) 
);
  DFFRE clk_sys_s0 (
    .Q(clk_sys),
    .D(n6_6),
    .CLK(HCLK_d),
    .RESET(GND),
    .CE(VCC) 
);
defparam clk_sys_s0.INIT=1'b0;
  INV n6_s2 (
    .O(n6_6),
    .I(clk_sys) 
);
  m1_mvp_top u_soc (
    .clk_sys(clk_sys),
    .SWCLK_d(SWCLK_d),
    .HRST_d(HRST_d),
    .SWDIO_in(SWDIO_in),
    .swdio_6(swdio_6),
    .swdio_o_Z(swdio_o_Z),
    .LED_d(LED_d[3:0]),
    .GPIO_d(GPIO_d[1:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
